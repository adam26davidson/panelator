#!/usr/bin/env node
// A reversible stand-in for `systemd-creds` (spec 069 section 3): the blob is the reversed bytes, base64, behind a marker.
// Set FAKE_SYSTEMD_CREDS_FAIL to make it exit 1.
import { readFileSync, writeFileSync } from "node:fs";
if (process.env.FAKE_SYSTEMD_CREDS_FAIL) {
  console.error("fake systemd-creds: failing as asked");
  process.exit(1);
}
const args = process.argv.slice(2);
const verb = args.find((a) => a === "encrypt" || a === "decrypt");
if (verb === "encrypt") {
  const input = readFileSync(0);
  writeFileSync(args[args.length - 1], "FAKE-CRED:" + Buffer.from(input).reverse().toString("base64"));
} else if (verb === "decrypt") {
  const blob = readFileSync(args[args.length - 2], "utf8");
  if (!blob.startsWith("FAKE-CRED:")) {
    console.error("fake systemd-creds: not a blob");
    process.exit(1);
  }
  process.stdout.write(Buffer.from(blob.slice(10), "base64").reverse());
} else {
  console.error("fake systemd-creds: unknown verb");
  process.exit(2);
}
