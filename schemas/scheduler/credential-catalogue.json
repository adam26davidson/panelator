{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credential-catalogue.json",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "provider",
      "purpose",
      "access",
      "used_by",
      "wrapper",
      "expiry",
      "check",
      "renew",
      "setup"
    ],
    "additionalProperties": false,
    "properties": {
      "provider": {
        "type": "string",
        "minLength": 1
      },
      "purpose": {
        "type": "string",
        "minLength": 1
      },
      "access": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      },
      "used_by": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "wrapper": {
        "oneOf": [
          {
            "const": "none"
          },
          {
            "type": "object",
            "required": [
              "command",
              "env"
            ],
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "env": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "expiry": {
        "oneOf": [
          {
            "enum": [
              "none",
              "index"
            ]
          },
          {
            "type": "object",
            "required": [
              "probe"
            ],
            "additionalProperties": false,
            "properties": {
              "probe": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "check": {
        "type": "string",
        "minLength": 1
      },
      "renew": {
        "oneOf": [
          {
            "enum": [
              "none",
              "manual"
            ]
          },
          {
            "type": "object",
            "required": [
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "setup": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      }
    }
  }
}
