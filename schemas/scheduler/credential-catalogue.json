{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credential-catalogue.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "provider", "purpose", "access", "used_by", "wrapper", "expiry", "check", "renew", "setup"],
    "additionalProperties": false,
    "properties": {
      "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "provider": { "type": "string", "minLength": 1 },
      "purpose": { "type": "string", "minLength": 1 },
      "access": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
      "used_by": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
      "wrapper": {
        "oneOf": [
          { "const": "none" },
          {
            "type": "object",
            "required": ["command", "env"],
            "additionalProperties": false,
            "properties": { "command": { "type": "string", "minLength": 1 }, "env": { "type": "string", "minLength": 1 } }
          }
        ]
      },
      "expiry": {
        "oneOf": [
          { "enum": ["none", "index"] },
          { "type": "object", "required": ["probe"], "additionalProperties": false, "properties": { "probe": { "type": "string", "minLength": 1 } } }
        ]
      },
      "check": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "object", "required": ["builtin"], "additionalProperties": false, "properties": { "builtin": { "enum": ["github-app", "telegram-get-me"] } } }
        ]
      },
      "renew": {
        "oneOf": [
          { "enum": ["none", "manual"] },
          { "type": "object", "required": ["command"], "additionalProperties": false, "properties": { "command": { "type": "string", "minLength": 1 } } }
        ]
      },
      "setup": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
    }
  }
}
