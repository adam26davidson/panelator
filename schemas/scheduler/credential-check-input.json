{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credential-check-input.json",
  "description": "Spec 099 AC-12: the catalogue joined with the index, the pre-run's check results and scope, the pending credential_expiry events and the parties. No secret and no plain-file list.",
  "type": "object",
  "properties": {
    "since": { "type": ["string", "null"] },
    "events": { "type": "array" },
    "warn_days": { "type": "integer" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "provider", "purpose", "access", "used_by", "set", "expiry", "expires_at", "days_left", "last_check", "renew"],
        "properties": {
          "name": { "type": "string" },
          "provider": { "type": "string" },
          "purpose": { "type": "string" },
          "access": { "type": "array", "items": { "type": "string" } },
          "used_by": { "type": "array", "items": { "type": "string" } },
          "set": { "type": "boolean" },
          "expiry": { "type": "string" },
          "expires_at": { "type": ["string", "null"] },
          "days_left": { "type": ["number", "null"] },
          "last_check": { "type": ["string", "null"] },
          "renew": { "type": "string" },
          "setup": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "checks": { "type": "object" },
    "scope": { "type": "object" },
    "parties": { "type": "array" }
  },
  "required": ["since", "events", "warn_days", "entries", "checks", "scope", "parties"],
  "additionalProperties": true
}
