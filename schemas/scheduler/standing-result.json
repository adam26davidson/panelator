{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standing-result.json",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "action.json"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding.json"
      }
    }
  },
  "required": [
    "summary"
  ],
  "additionalProperties": true
}
