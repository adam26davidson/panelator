{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fix-result.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "addressed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "out_of_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cause", "paths"],
          "properties": {
            "cause": { "type": "string", "minLength": 1 },
            "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "description": "Spec 060 AC-5: the failing check's cause lies outside the PR's scope; the paths whose change would clear it."
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Side-channel finding records; each is validated against finding.json when queued (AC-28), never a reason to fail the stage."
        },
        "escalation": {
          "type": "object",
          "allOf": [
            {
              "$ref": "question.json"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "not": {
                    "const": "other"
                  }
                }
              }
            }
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "head_sha",
            "addressed"
          ],
          "properties": {
            "head_sha": true,
            "addressed": true
          }
        },
        {
          "required": [
            "escalation"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "head_sha"
                ]
              },
              {
                "required": [
                  "addressed"
                ]
              }
            ]
          },
          "properties": {
            "escalation": true,
            "head_sha": true,
            "addressed": true
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation",
        "decision"
      ],
      "properties": {
        "conversation": {
          "const": "settled"
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "finding.json"
          }
        }
      }
    }
  ]
}
