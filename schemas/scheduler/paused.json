{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paused.json",
  "type": "object",
  "required": [
    "issue",
    "phase",
    "state",
    "question",
    "asking_stage",
    "nonce",
    "question_comment_id",
    "asked_at",
    "reminded"
  ],
  "additionalProperties": false,
  "properties": {
    "issue_title":{"type":"string"},
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "enum": [
        "pausing",
        "paused",
        "resuming"
      ]
    },
    "state": {
      "type": "object"
    },
    "question": {
      "$ref": "question.json"
    },
    "asking_stage": {
      "enum": [
        "plan",
        "implement",
        "review",
        "fix",
        "spec",
        "verify"
      ]
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    },
    "question_comment_id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "asked_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "reminded": {
      "type": "boolean"
    },
    "answer": {
      "type": [
        "string",
        "null"
      ]
    },
    "reply_comment_id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "session": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "harness",
        "model",
        "session_id",
        "worktree"
      ],
      "properties": {
        "harness": {
          "enum": [
            "claude",
            "pi",
            "fake"
          ]
        },
        "model": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "worktree": {
          "type": "string"
        }
      }
    },
    "telegram": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "message_id",
        "sent",
        "sent_at",
        "send_failures",
        "reminder_message_id",
        "thread_message_ids",
        "thread_last_message_id",
        "answer_update_id",
        "ack_sent",
        "channel"
      ],
      "properties": {
        "message_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reminder_message_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "thread_last_message_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "answer_update_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sent": {
          "type": "boolean"
        },
        "ack_sent": {
          "type": "boolean"
        },
        "sent_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "send_failures": {
          "type": "integer",
          "minimum": 0
        },
        "thread_message_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "channel": {
          "enum": [
            "telegram",
            "issue",
            null
          ]
        }
      }
    }
  }
}
