{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reflection-input.json",
  "type": "object",
  "properties": {
    "period": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "agent": {
      "type": "string"
    },
    "parameters": {
      "type": "object"
    },
    "agents": {
      "type": "object"
    },
    "metrics": {
      "$ref": "metrics-report.json"
    },
    "events_summary": {
      "type": "object"
    },
    "issues": {
      "type": "array"
    },
    "open_questions": {
      "type": "array"
    },
    "previous_plans": {
      "type": "array"
    },
    "open_bot_issues": {
      "type": "array"
    },
    "findings_pending": {
      "type": "object"
    },
    "design_tree": {
      "type": "object"
    },
    "charter": {
      "type": "array"
    },
    "console_available": {
      "type": "boolean"
    },
    "maintainer_contacts": {
      "type": "array"
    },
    "metric_definitions": {
      "type": "array"
    },
    "snapshots": {
      "type": "array"
    },
    "all_plans": {
      "type": "array"
    },
    "question_outcomes": {
      "type": "array"
    }
  },
  "required": [
    "period",
    "agent",
    "parameters",
    "agents",
    "metrics",
    "events_summary",
    "issues",
    "open_questions",
    "previous_plans",
    "open_bot_issues",
    "findings_pending"
  ],
  "additionalProperties": false
}
