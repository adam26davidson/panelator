{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question.json",
  "type": "object",
  "required": [
    "kind",
    "question",
    "options",
    "recommendation"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "product",
        "technical",
        "capability",
        "other"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "cost"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "cost": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    },
    "follow_up": {
      "type": "boolean",
      "description": "C2: answers the maintainer's reply, which asked something back; set only with reply_quote."
    },
    "reply_quote": {
      "type": "string",
      "minLength": 1,
      "description": "C2: the part of the maintainer's reply this follow-up answers, quoted."
    },
    "new_blocker": {
      "type": "boolean",
      "description": "C3: in decide mode, a blocker other than the question sent back to decide."
    }
  },
  "dependentRequired": {
    "follow_up": [
      "reply_quote"
    ]
  }
}
