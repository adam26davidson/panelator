{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question.json",
  "type": "object",
  "required": [
    "kind",
    "question",
    "options",
    "recommendation"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "product",
        "technical",
        "capability",
        "other"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "cost"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "cost": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    },
    "follow_up": {
      "type": "boolean",
      "description": "C2: answers the maintainer's reply, which asked something back; set only with reply_quote."
    },
    "reply_quote": {
      "type": "string",
      "minLength": 1,
      "description": "C2: the part of the maintainer's reply this follow-up answers, quoted."
    },
    "new_blocker": {
      "type": "boolean",
      "description": "C3: in decide mode, a blocker other than the question sent back to decide."
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "name",
            "provider",
            "access",
            "setup"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "credential"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "access": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "setup": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "amount_usd",
            "purpose",
            "charter_goal"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "funds"
            },
            "amount_usd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "charter_goal": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "party",
            "channel",
            "why",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "first_contact"
            },
            "party": {
              "type": "string",
              "minLength": 1
            },
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "why": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "dependentRequired": {
    "follow_up": [
      "reply_quote"
    ]
  }
}
