{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question.json",
  "type": "object",
  "required": [
    "kind",
    "question",
    "options",
    "recommendation"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "product",
        "technical",
        "capability",
        "other"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "cost"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "cost": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    }
  }
}
