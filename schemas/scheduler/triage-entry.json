{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "triage-entry.json",
  "type": "object",
  "properties": {
    "ref": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "rests_on_pr": {
      "type": "integer",
      "minimum": 1
    },
    "rests_on_pr_state": {
      "enum": [
        "merged",
        "reoffer_limit"
      ]
    },
    "reoffered": {
      "type": "boolean"
    }
  },
  "required": [
    "ref",
    "outcome",
    "reason",
    "run_id",
    "at"
  ],
  "additionalProperties": true
}
