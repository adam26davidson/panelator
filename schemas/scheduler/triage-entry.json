{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "triage-entry.json",
  "type": "object",
  "properties": {
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "rests_on_pr": {
      "type": "integer",
      "minimum": 1
    },
    "rests_on_pr_state": {
      "enum": [
        "merged",
        "reoffer_limit"
      ]
    },
    "reoffered": {
      "type": "boolean"
    },
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "capability_issue": {
      "type": "integer",
      "minimum": 1
    },
    "advisory": {
      "type": "string"
    },
    "blocked_until": {
      "type": "string",
      "minLength": 1
    },
    "failed": {
      "type": "boolean"
    },
    "held": {
      "type": "boolean"
    },
    "stops_pipeline": {
      "type": "boolean"
    },
    "failure": {
      "enum": [
        "permission",
        "error"
      ]
    },
    "blocked_by": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1
    },
    "finding": {
      "type": "object"
    }
  },
  "required": [
    "ref",
    "outcome",
    "reason",
    "run_id",
    "at"
  ],
  "additionalProperties": false
}
