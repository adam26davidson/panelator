{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.json",
  "type": "object",
  "required": [
    "issue",
    "slot",
    "state",
    "worktree",
    "started_at",
    "last_activity_at",
    "run_id"
  ],
  "additionalProperties": false,
  "properties": {
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "slot": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "type": "object",
      "description": "ChainState (tools/scheduler/src/chain/types.ts). Fields added by spec 006 are optional so a pre-006 claim stays readable; it is validated after normalizeChainState fills them.",
      "required": [
        "issue",
        "stage",
        "attempt",
        "fixes",
        "scopeViolations",
        "planFailures",
        "implementFailures",
        "sensitive",
        "pr",
        "plan",
        "pendingFixInput",
        "postponedUntil",
        "resumeStage",
        "conflictPending"
      ],
      "additionalProperties": false,
      "properties": {
        "issue": {
          "type": "integer",
          "minimum": 1
        },
        "stage": {
          "enum": [
            "claimed",
            "plan",
            "implement",
            "verify",
            "review",
            "fix",
            "merge",
            "spec",
            "question-check",
            "done",
            "released",
            "waiting",
            "paused",
            "abandoned"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "fixes": {
          "type": "integer",
          "minimum": 0
        },
        "scopeViolations": {
          "type": "integer",
          "minimum": 0
        },
        "planFailures": {
          "type": "integer",
          "minimum": 0
        },
        "implementFailures": {
          "type": "integer",
          "minimum": 0
        },
        "sensitive": {
          "type": "boolean"
        },
        "pr": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "number",
                "head_sha"
              ],
              "additionalProperties": false,
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "head_sha": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "plan": {
          "type": [
            "object",
            "null"
          ]
        },
        "pendingFixInput": {
          "type": [
            "string",
            "null"
          ]
        },
        "postponedUntil": {
          "type": [
            "string",
            "null"
          ]
        },
        "resumeStage": {
          "enum": [
            "plan",
            "implement",
            "review",
            "fix",
            "spec",
            "question-check",
            null
          ]
        },
        "conflictPending": {
          "type": "boolean"
        },
        "track": {
          "enum": [
            "issue",
            "spec"
          ]
        },
        "rescues": {
          "type": "integer",
          "minimum": 0
        },
        "specRescues": {
          "type": "integer",
          "minimum": 0
        },
        "replans": {
          "type": "integer",
          "minimum": 0
        },
        "specRevisions": {
          "type": "integer",
          "minimum": 0
        },
        "specAnswers": {
          "type": "integer",
          "minimum": 0
        },
        "decideReturns": {
          "type": "integer",
          "minimum": 0
        },
        "history": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "rescueRun": {
          "type": "boolean"
        },
        "specMode": {
          "enum": [
            "write",
            "answer",
            "revise",
            "decide",
            "record",
            null
          ]
        },
        "specProblem": {
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "question.json"
            }
          ]
        },
        "askingStage": {
          "enum": [
            "plan",
            "implement",
            "review",
            "fix",
            "spec",
            "verify",
            null
          ]
        },
        "answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "answerQuestionId": {
          "type": [
            "integer",
            "null"
          ]
        },
        "answerKind": {
          "enum": [
            "product",
            "technical",
            "capability",
            "other",
            null
          ]
        },
        "recordAnswer": {
          "type": "boolean"
        },
        "decideInput": {
          "type": [
            "string",
            "null"
          ]
        },
        "parkedPr": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "number",
                "head_sha"
              ],
              "additionalProperties": false,
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "head_sha": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "pendingSince": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "checksRerun": {
          "type": "boolean"
        },
        "answerQuestionIds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "pendingAnswer": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "ids",
                "kind",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer"
                  }
                },
                "kind": {
                  "enum": [
                    "product",
                    "technical"
                  ]
                },
                "text": {
                  "type": "string"
                }
              }
            }
          ],
          "description": "T4: a product or technical answer not yet recorded on main; a re-claim records it first."
        },
        "securityPass": {
          "type": "boolean"
        },
        "chainFailures": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "count",
                "last"
              ],
              "additionalProperties": false,
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 0
                },
                "last": {
                  "type": "string"
                }
              }
            }
          ],
          "description": "C7: consecutive driver errors on the chain and the last error."
        },
        "chainErrors": {
          "type": "integer",
          "minimum": 0,
          "description": "C7: releases for repeated chain errors."
        },
        "decidedQuestion": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "question.json"
            }
          ],
          "description": "CM2: the question sent back to decide, while decide mode lasts."
        },
        "recordIds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "TI1: answered product or technical questions a recording run must still mark."
        },
        "recordKind": {
          "enum": [
            "product",
            "technical",
            null
          ]
        },
        "resumeSession": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "harness",
            "model",
            "session_id",
            "worktree"
          ],
          "properties": {
            "harness": {
              "enum": [
                "claude",
                "pi",
                "fake"
              ]
            },
            "model": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "worktree": {
              "type": "string"
            }
          }
        },
        "conversation": {
          "type": [
            "object",
            "null"
          ]
        },
        "decision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "worktree": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "pendingEvent": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "answer",
            "questionId"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "answered"
            },
            "answer": {
              "type": "string"
            },
            "questionId": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "error"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "chain_error"
            },
            "error": {
              "type": "string"
            }
          }
        }
      ]
    },
    "pendingActions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string"
          }
        }
      }
    },
    "asking_session": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "harness",
        "model",
        "session_id",
        "worktree"
      ],
      "properties": {
        "harness": {
          "enum": [
            "claude",
            "pi",
            "fake"
          ]
        },
        "model": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "worktree": {
          "type": "string"
        }
      }
    },
    "telegram_thread": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "message_id",
        "sent",
        "sent_at",
        "send_failures",
        "reminder_message_id",
        "thread_message_ids",
        "thread_last_message_id",
        "answer_update_id",
        "ack_sent",
        "channel"
      ],
      "properties": {
        "message_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reminder_message_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "thread_last_message_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "answer_update_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sent": {
          "type": "boolean"
        },
        "ack_sent": {
          "type": "boolean"
        },
        "sent_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "send_failures": {
          "type": "integer",
          "minimum": 0
        },
        "thread_message_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "channel": {
          "enum": [
            "telegram",
            "issue",
            null
          ]
        }
      }
    },
    "stageRun": {
      "description": "Spec 015 AC-10: a stage run that ended ok, recorded before its result is checked.",
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "attempt", "run_id", "result", "start", "security", "sensitive"],
      "properties": {
        "stage": { "enum": ["plan", "implement", "review", "fix", "spec", "question-check"] },
        "attempt": { "type": "integer", "minimum": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "result": {},
        "start": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "security": { "type": "boolean" },
        "sensitive": { "type": "boolean" }
      }
    },
    "outage": {
      "description": "Spec 015 AC-5: the claim's consecutive transient failures.",
      "type": "object",
      "additionalProperties": false,
      "required": ["since", "count", "last", "retry_at", "alarmed"],
      "properties": {
        "since": { "type": "string", "format": "date-time" },
        "count": { "type": "integer", "minimum": 1 },
        "last": { "type": "string" },
        "retry_at": { "type": "string", "format": "date-time" },
        "alarmed": { "type": "boolean" }
      }
    }
  }
}
