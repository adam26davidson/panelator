{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.json",
  "$defs": {
    "envelope": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "enum": [
            "run.ended",
            "chain.transition",
            "issue.eligible",
            "issue.claimed",
            "issue.released",
            "merge",
            "pr.opened",
            "ci.check",
            "review.result",
            "finding.queued",
            "finding.triaged",
            "action",
            "question",
            "pause.started",
            "pause.ended",
            "slots.sample",
            "maintainer.contact",
            "parameter.changed",
            "agent.run",
            "issue.filed",
            "reflection.plan",
            "metrics.snapshot",
            "aws.cost"
          ]
        },
        "issue": {
          "type": "integer",
          "minimum": 0
        },
        "run_id": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "at",
        "kind",
        "payload"
      ],
      "additionalProperties": false
    },
    "payloads": {
      "chain.transition": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "attempt": {
            "type": "integer"
          },
          "fixes": {
            "type": "integer"
          },
          "track": true,
          "rescue": true
        },
        "required": [
          "from",
          "to",
          "event",
          "attempt",
          "fixes",
          "track",
          "rescue"
        ]
      },
      "issue.eligible": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer"
          },
          "work": {
            "type": "string"
          },
          "cls": {
            "type": "string"
          },
          "validated_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "rank",
          "work",
          "cls",
          "validated_at",
          "created_at"
        ]
      },
      "issue.claimed": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "integer"
          }
        },
        "required": [
          "slot"
        ]
      },
      "issue.released": {
        "type": "object",
        "properties": {
          "reason": {
            "enum": [
              "done",
              "abandoned",
              "postponed",
              "paused",
              "error",
              "stopped"
            ]
          }
        },
        "required": [
          "reason"
        ]
      },
      "merge": {
        "type": "object",
        "properties": {
          "issue": {
            "type": "integer"
          },
          "pr": {
            "type": "integer"
          },
          "cls": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "work": {
            "type": "string"
          }
        },
        "required": [
          "issue",
          "pr",
          "cls",
          "at"
        ]
      },
      "pr.opened": {
        "type": "object",
        "properties": {
          "pr": {
            "type": "integer"
          },
          "track": {
            "type": "string"
          }
        },
        "required": [
          "pr",
          "track"
        ]
      },
      "ci.check": {
        "type": "object",
        "properties": {
          "sha": {
            "type": "string"
          },
          "pr": {
            "type": "integer"
          },
          "check": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "run_id": true
        },
        "required": [
          "sha",
          "check",
          "status",
          "run_id"
        ]
      },
      "review.result": {
        "type": "object",
        "properties": {
          "pr": {
            "type": "integer"
          },
          "head_sha": {
            "type": "string"
          },
          "verdict": {
            "type": "string"
          },
          "findings": {
            "type": "integer"
          },
          "independent": {
            "type": "boolean"
          },
          "reviewer_model": {
            "type": "string"
          },
          "security": {
            "type": "boolean"
          },
          "criteria_failed": true
        },
        "required": [
          "pr",
          "head_sha",
          "verdict",
          "findings",
          "criteria_failed",
          "independent",
          "reviewer_model",
          "security"
        ]
      },
      "finding.queued": {
        "type": "object",
        "required": []
      },
      "pause.started": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "question_comment_id": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "stage",
          "reason"
        ]
      },
      "pause.ended": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "question_comment_id": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "stage",
          "reason"
        ]
      },
      "slots.sample": {
        "type": "object",
        "properties": {
          "active": {
            "type": "integer"
          },
          "slots": {
            "type": "integer"
          },
          "chains": {
            "type": "integer"
          },
          "standing": {
            "type": "integer"
          }
        },
        "required": [
          "active",
          "slots",
          "chains",
          "standing"
        ]
      },
      "maintainer.contact": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "notification",
              "question",
              "reminder",
              "funds",
              "credential",
              "first_contact"
            ]
          },
          "issue": {
            "type": "integer"
          },
          "question_comment_id": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "channel",
          "kind",
          "label",
          "text"
        ]
      },
      "parameter.changed": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "field",
          "actor",
          "at"
        ]
      },
      "agent.run": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "events_received": {
            "type": "integer"
          },
          "actions": {
            "type": "integer"
          },
          "findings": {
            "type": "integer"
          },
          "attempt": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "outcome",
          "summary",
          "events_received",
          "actions",
          "findings",
          "attempt"
        ]
      },
      "issue.filed": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer"
          },
          "by": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "marker": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "number",
          "by",
          "class",
          "labels",
          "marker",
          "body"
        ]
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/envelope"
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "run.ended"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "usage-record.json"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "action"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "action-log-entry.json"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "question"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "question-log-entry.json"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "finding.triaged"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "triage-entry.json"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "chain.transition"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payloads/chain.transition"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "issue.eligible"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payloads/issue.eligible"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "issue.claimed"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payloads/issue.claimed"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "issue.released"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payloads/issue.released"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "merge"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payloads/merge"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "pr.opened"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payloads/pr.opened"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ci.check"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payloads/ci.check"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "review.result"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payloads/review.result"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "finding.queued"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payloads/finding.queued"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "pause.started"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payloads/pause.started"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "pause.ended"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payloads/pause.ended"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "slots.sample"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payloads/slots.sample"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "maintainer.contact"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payloads/maintainer.contact"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "parameter.changed"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payloads/parameter.changed"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "agent.run"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payloads/agent.run"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "issue.filed"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payloads/issue.filed"
          }
        },
        "type": "object"
      }
    }
  ]
}
