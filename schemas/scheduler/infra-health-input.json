{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infra-health-input.json",
  "type": "object",
  "properties": {
    "since": { "type": ["string", "null"] },
    "events": { "type": "array" },
    "disk_sweep": { "type": ["object", "null"] },
    "free_space": { "type": "array" },
    "agents": { "type": "object" },
    "service_log": { "type": "array" },
    "actions": { "type": "array" },
    "skipped_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "skipped": { "type": "integer" },
          "recovered": { "type": "integer" },
          "offsets": { "type": "array", "items": { "type": "integer" } },
          "lines": { "type": "array", "items": { "type": "integer" } }
        },
        "required": ["file", "skipped", "recovered", "offsets"],
        "additionalProperties": true
      }
    }
  },
  "required": ["since", "events", "disk_sweep", "free_space", "agents", "service_log", "actions", "skipped_lines"],
  "additionalProperties": true
}
