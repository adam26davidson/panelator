{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infra-health-input.json",
  "type": "object",
  "properties": {
    "since": { "type": ["string", "null"] },
    "events": { "type": "array" },
    "disk_sweep": { "type": ["object", "null"] },
    "free_space": { "type": "array" },
    "agents": { "type": "object" },
    "service_log": { "type": "array" },
    "actions": { "type": "array" },
    "aws": {
      "type": "object",
      "required": ["on", "cap_usd", "cost", "reservations"],
      "properties": {
        "on": { "type": "boolean" },
        "off_reason": { "type": "string" },
        "cap_usd": { "type": "number", "minimum": 0 },
        "cost": { "type": ["object", "null"] },
        "reservations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "what", "expected_monthly_usd", "by", "at"],
            "properties": {
              "id": { "type": "string" },
              "what": { "type": "string" },
              "expected_monthly_usd": { "type": "number" },
              "by": { "type": "string" },
              "at": { "type": "string" },
              "scale": { "type": "object" }
            }
          }
        }
      }
    },
    "skipped_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "skipped": { "type": "integer" },
          "recovered": { "type": "integer" },
          "offsets": { "type": "array", "items": { "type": "integer" } },
          "lines": { "type": "array", "items": { "type": "integer" } }
        },
        "required": ["file", "skipped", "recovered", "offsets"],
        "additionalProperties": true
      }
    }
  },
  "required": ["since", "events", "disk_sweep", "free_space", "agents", "service_log", "actions", "aws", "skipped_lines"],
  "additionalProperties": true
}
