{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question-log-entry.json",
  "type": "object",
  "required": [
    "issue",
    "at",
    "event",
    "asking_stage"
  ],
  "additionalProperties": false,
  "properties": {
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "at": {
      "type": "string",
      "minLength": 1
    },
    "event": {
      "enum": [
        "asked",
        "checked",
        "sent",
        "reminded",
        "answered"
      ]
    },
    "asking_stage": {
      "enum": [
        "plan",
        "implement",
        "review",
        "fix",
        "spec",
        "design",
        "verify"
      ]
    },
    "question_comment_id": {
      "type": "integer",
      "minimum": 1
    },
    "question": {
      "$ref": "question.json"
    },
    "verdict": {
      "type": "string"
    },
    "reasoning": {
      "type": "string"
    },
    "reply_comment_id": {
      "type": "integer",
      "minimum": 1
    },
    "answer": {
      "type": "string"
    },
    "channel": {
      "enum": [
        "telegram",
        "issue"
      ]
    },
    "telegram_message_id": {
      "type": "integer"
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "name",
            "provider",
            "access",
            "setup"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "credential"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "access": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "setup": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "amount_usd",
            "purpose",
            "charter_goal"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "funds"
            },
            "amount_usd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "charter_goal": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "party",
            "channel",
            "why",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "first_contact"
            },
            "party": {
              "type": "string",
              "minLength": 1
            },
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "why": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "outcome": {
      "enum": [
        "approved",
        "denied",
        "declined",
        "verified",
        "check_failed",
        "text"
      ]
    }
  }
}
