{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "filer-result.json",
  "allOf": [
    {
      "$ref": "standing-result.json"
    },
    {
      "type": "object",
      "properties": {
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "discard",
                  "file",
                  "merge_into",
                  "escalate",
                  "security",
                  "retry",
                  "rewrite",
                  "close",
                  "defer"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "issue": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1
                  },
                  "class": {
                    "type": "string",
                    "minLength": 1
                  },
                  "stops_pipeline": {
                    "type": "boolean"
                  },
                  "blocked_by": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true,
                    "description": "Spec 066: issues the work waits for; the issue is filed blocked and the children scan lifts it."
                  },
                  "blocked_until": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Spec 066: one sentence naming a condition no issue stands for; the label is lifted by hand."
                  }
                },
                "required": [
                  "title",
                  "body",
                  "class"
                ],
                "additionalProperties": false,
                "not": {
                  "type": "object",
                  "properties": {"blocked_by": {}, "blocked_until": {}},
                  "required": ["blocked_by", "blocked_until"]
                }
              },
              "issue_number": {
                "type": "integer",
                "minimum": 1
              },
              "rests_on_pr": {
                "type": "integer",
                "minimum": 1,
                "description": "Spec 025: on a discard, the unmerged PR it relies on; the record is offered again if that PR closes unmerged."
              },
              "question": {
                "$ref": "question.json"
              },
              "advisory": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "severity": {
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "critical"
                    ]
                  }
                },
                "required": [
                  "title",
                  "description",
                  "severity"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "ref",
              "outcome",
              "reason"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "issue": {
                      "anyOf": [
                        {"type": "object", "properties": {"blocked_by": {}}, "required": ["blocked_by"]},
                        {"type": "object", "properties": {"blocked_until": {}}, "required": ["blocked_until"]}
                      ]
                    }
                  },
                  "required": ["issue"]
                },
                "then": {
                  "properties": {
                    "outcome": {
                      "enum": ["file", "rewrite"]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {"rests_on_pr": {}},
                  "required": ["rests_on_pr"]
                },
                "then": {
                  "properties": {
                    "outcome": {
                      "const": "discard"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "outcome": {
                      "enum": [
                        "file",
                        "rewrite",
                        "escalate"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {"issue": {}},
                  "required": ["issue"]
                }
              },
              {
                "if": {
                  "properties": {
                    "outcome": {
                      "const": "merge_into"
                    }
                  }
                },
                "then": {
                  "properties": {"issue_number": {}},
                  "required": ["issue_number"]
                }
              },
              {
                "if": {
                  "properties": {
                    "outcome": {
                      "const": "escalate"
                    }
                  }
                },
                "then": {
                  "properties": {"question": {}},
                  "required": ["question"]
                }
              },
              {
                "if": {
                  "properties": {
                    "outcome": {
                      "const": "security"
                    }
                  }
                },
                "then": {
                  "properties": {"advisory": {}},
                  "required": ["advisory"]
                }
              }
            ]
          }
        }
      },
      "required": [
        "decisions"
      ],
      "additionalProperties": true
    }
  ]
}
