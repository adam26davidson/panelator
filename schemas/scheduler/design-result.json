{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-result.json",
  "oneOf": [
    {
      "type": "object",
      "required": ["verdict"],
      "additionalProperties": false,
      "properties": {
        "verdict": { "enum": ["designed", "question"] },
        "spec_path": { "type": "string", "pattern": "^specs/[0-9]{3}-[a-z0-9-]+/spec\\.md$" },
        "pr_number": { "type": "integer", "minimum": 1 },
        "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "screens": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "stories", "renders"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "stories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "renders": { "type": "array", "minItems": 3, "items": { "type": "string" } }
            }
          }
        },
        "question": { "$ref": "question.json" },
        "findings": {
          "type": "array",
          "items": { "type": "object" },
          "description": "Side-channel finding records; each is validated against finding.json when queued, never a reason to fail the stage."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "designed" } }, "required": ["verdict"] },
          "then": { "required": ["spec_path", "pr_number", "head_sha", "screens"] }
        },
        {
          "if": { "properties": { "verdict": { "const": "question" } }, "required": ["verdict"] },
          "then": { "required": ["question"] }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversation", "decision"],
      "properties": {
        "conversation": { "const": "settled" },
        "decision": { "type": "string", "minLength": 1 },
        "findings": { "type": "array", "items": { "$ref": "finding.json" } }
      }
    }
  ]
}
