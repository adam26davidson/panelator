{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credential-check-result.json",
  "allOf": [
    {
      "$ref": "standing-result.json"
    },
    {
      "type": "object",
      "properties": {
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "expires_at",
              "steps"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  ]
}
