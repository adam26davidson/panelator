{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "escalation-ledger.json",
  "type": "object",
  "required": [
    "rescues",
    "specRescues",
    "replans",
    "specRevisions",
    "specAnswers",
    "decideReturns",
    "history"
  ],
  "additionalProperties": false,
  "properties": {
    "rescues": {
      "type": "integer",
      "minimum": 0
    },
    "specRescues": {
      "type": "integer",
      "minimum": 0
    },
    "replans": {
      "type": "integer",
      "minimum": 0
    },
    "specRevisions": {
      "type": "integer",
      "minimum": 0
    },
    "specAnswers": {
      "type": "integer",
      "minimum": 0
    },
    "decideReturns": {
      "type": "integer",
      "minimum": 0
    },
    "history": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pendingAnswer": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "ids",
            "kind",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer"
              }
            },
            "kind": {
              "enum": [
                "product",
                "technical"
              ]
            },
            "text": {
              "type": "string"
            }
          }
        }
      ],
      "description": "T4: a product or technical answer not yet recorded on main; a re-claim records it first."
    },
    "chainFailures": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "count",
            "last"
          ],
          "additionalProperties": false,
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "last": {
              "type": "string"
            }
          }
        }
      ],
      "description": "C7: consecutive driver errors on the chain and the last error."
    },
    "chainErrors": {
      "type": "integer",
      "minimum": 0,
      "description": "C7: releases for repeated chain errors."
    },
    "designRevisions": {
      "type": "integer",
      "minimum": 0
    },
    "designRescues": {
      "type": "integer",
      "minimum": 0
    }
  }
}
