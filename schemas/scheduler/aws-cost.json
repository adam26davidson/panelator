{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aws-cost.json",
  "title": "AWS cost record (spec 022 AC-4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "month",
    "actual_usd",
    "as_of",
    "cap_usd",
    "reserved_usd",
    "forecast_usd",
    "days_elapsed",
    "days_in_month",
    "source"
  ],
  "properties": {
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "actual_usd": {
      "type": "number",
      "minimum": 0
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "cap_usd": {
      "type": "number",
      "minimum": 0
    },
    "reserved_usd": {
      "type": "number",
      "minimum": 0
    },
    "forecast_usd": {
      "type": "number",
      "minimum": 0
    },
    "days_elapsed": {
      "type": "integer",
      "minimum": 0
    },
    "days_in_month": {
      "type": "integer",
      "minimum": 28,
      "maximum": 31
    },
    "source": {
      "const": "ce"
    }
  }
}
