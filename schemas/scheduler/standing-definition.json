{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standing-definition.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "kind": {
      "const": "standing"
    },
    "trigger": {
      "type": "object",
      "properties": {
        "schedule": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?[mhd]$"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "harness": {
      "enum": [
        "claude",
        "pi"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "enum": [
        "strong",
        "standard"
      ]
    },
    "bounds": {
      "type": "object",
      "properties": {
        "timeout_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_turns": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "timeout_min",
        "max_turns",
        "max_cost_usd"
      ],
      "additionalProperties": false
    },
    "permission": {
      "const": "no-prompt"
    },
    "worktree": {
      "enum": [
        "fresh",
        "none"
      ]
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "input": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "output": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallback": {
      "type": "string",
      "minLength": 1
    },
    "independent": {
      "type": "boolean"
    },
    "effort": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "kind",
    "trigger",
    "harness",
    "model",
    "tier",
    "bounds",
    "permission",
    "worktree",
    "profile",
    "input",
    "output"
  ],
  "additionalProperties": false
}
