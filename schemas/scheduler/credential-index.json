{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credential-index.json",
  "description": "index.json of the credential store (spec 030 AC-1): one entry per stored secret, keyed by name. Never holds a secret.",
  "type": "object",
  "additionalProperties": { "$ref": "#/$defs/entry" },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["name", "created_at", "set_by", "expires_at", "last_checked_at", "last_check"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string" },
        "set_by": { "enum": ["maintainer", "import"] },
        "expires_at": { "type": ["string", "null"] },
        "last_checked_at": { "type": ["string", "null"] },
        "last_check": { "type": ["string", "null"] },
        "renewable": { "type": "boolean" },
        "heads_up_for": { "type": "string" }
      }
    }
  }
}
