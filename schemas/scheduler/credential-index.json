{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credential-index.json",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "created_at",
      "set_by",
      "expires_at",
      "last_checked_at",
      "last_check"
    ],
    "additionalProperties": false,
    "properties": {
      "created_at": {
        "type": "string",
        "minLength": 1
      },
      "set_by": {
        "enum": [
          "maintainer",
          "import"
        ]
      },
      "expires_at": {
        "type": [
          "string",
          "null"
        ]
      },
      "last_checked_at": {
        "type": [
          "string",
          "null"
        ]
      },
      "last_check": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
