{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aws-ledger.json",
  "title": "AWS spend ledger (spec 022 AC-6)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reservations"
  ],
  "properties": {
    "reservations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "what",
          "expected_monthly_usd",
          "why",
          "by",
          "at",
          "released_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "what": {
            "type": "string",
            "minLength": 10
          },
          "expected_monthly_usd": {
            "type": "number",
            "minimum": 0
          },
          "why": {
            "type": "string",
            "minLength": 10
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "released_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "scale": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id",
              "up",
              "down",
              "state"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "lambda-concurrency",
                  "cloudfront-distribution",
                  "dynamodb-throughput"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "up": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expected_monthly_usd",
                  "setting"
                ],
                "properties": {
                  "expected_monthly_usd": {
                    "type": "number",
                    "minimum": 0
                  },
                  "setting": {
                    "type": "object"
                  }
                }
              },
              "down": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expected_monthly_usd",
                  "setting"
                ],
                "properties": {
                  "expected_monthly_usd": {
                    "type": "number",
                    "minimum": 0
                  },
                  "setting": {
                    "type": "object"
                  }
                }
              },
              "state": {
                "enum": [
                  "up",
                  "down"
                ]
              }
            }
          }
        }
      }
    }
  }
}
