{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metrics-report.json",
  "type": "object",
  "properties": {
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "computed_at": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "lower",
              "higher"
            ]
          },
          "introduced": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "replaced",
              "retired"
            ]
          },
          "replaced_by": {
            "type": "string"
          },
          "overlap_days_left": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "buckets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bucket": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "n": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "bucket",
                "value",
                "n"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "goal",
          "unit",
          "direction",
          "introduced",
          "status",
          "buckets"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "from",
    "to",
    "computed_at",
    "metrics"
  ],
  "additionalProperties": false
}
