{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-state.json",
  "type": "object",
  "properties": {
    "last_run": {
      "type": [
        "object",
        "null"
      ]
    },
    "next_run": {
      "type": [
        "string",
        "null"
      ]
    },
    "pending_events": {
      "type": "array"
    },
    "paused": {
      "type": "boolean"
    },
    "paused_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "failures": {
      "type": "integer",
      "minimum": 0
    },
    "last_success": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "last_run",
    "next_run",
    "pending_events",
    "paused",
    "paused_by",
    "failures"
  ],
  "additionalProperties": true
}
