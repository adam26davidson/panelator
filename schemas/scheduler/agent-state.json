{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-state.json",
  "type": "object",
  "properties": {
    "last_run": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "at",
        "run_id",
        "outcome"
      ],
      "additionalProperties": false
    },
    "next_run": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "pending_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "payload": {},
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "event",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "paused": {
      "type": "boolean"
    },
    "paused_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "failures": {
      "type": "integer",
      "minimum": 0
    },
    "outage": {
      "type": "object",
      "properties": {
        "since": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "last": {
          "type": "string"
        },
        "alarmed": {
          "type": "boolean"
        },
        "past_ceiling": {
          "type": "object",
          "properties": {
            "since": {
              "type": "string"
            },
            "failures": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "since",
            "failures"
          ],
          "additionalProperties": false
        },
        "ceiling": {
          "type": "boolean"
        }
      },
      "required": [
        "since",
        "count",
        "last",
        "alarmed"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "string"
    },
    "removed_at": {
      "type": "string",
      "format": "date-time"
    },
    "postponed_until": {
      "type": "string",
      "format": "date-time"
    },
    "running": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "run_id",
        "started_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "last_run",
    "next_run",
    "pending_events",
    "paused",
    "paused_by",
    "failures"
  ],
  "additionalProperties": false
}
