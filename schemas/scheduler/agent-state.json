{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-state.json",
  "type": "object",
  "properties": {
    "last_run": {
      "type": [
        "object",
        "null"
      ]
    },
    "next_run": {
      "type": [
        "string",
        "null"
      ]
    },
    "pending_events": {
      "type": "array"
    },
    "paused": {
      "type": "boolean"
    },
    "paused_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "failures": {
      "type": "integer",
      "minimum": 0
    },
    "outage": {
      "type": "object",
      "properties": {
        "since": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "last": { "type": "string" },
        "alarmed": { "type": "boolean" },
        "past_ceiling": {
          "type": "object",
          "properties": {
            "since": { "type": "string" },
            "failures": { "type": "integer", "minimum": 0 }
          },
          "required": ["since", "failures"]
        },
        "ceiling": { "type": "boolean" }
      },
      "required": ["since", "count", "last", "alarmed"]
    }
  },
  "required": [
    "last_run",
    "next_run",
    "pending_events",
    "paused",
    "paused_by",
    "failures"
  ],
  "additionalProperties": true
}
