{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reflection-plan.json",
  "type": "object",
  "properties": {
    "plan": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "what": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              }
            },
            "required": [
              "what",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string"
              },
              "class": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "bottleneck",
                  "charter",
                  "automate_contact",
                  "metric_change",
                  "agent_change",
                  "other"
                ]
              },
              "existing_issue": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "title",
              "body",
              "class",
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "metrics_note": {
          "type": "string"
        },
        "open_questions_note": {
          "type": "string"
        },
        "deferred": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "why"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "summary",
        "observations",
        "items",
        "metrics_note",
        "open_questions_note",
        "deferred"
      ],
      "additionalProperties": false
    },
    "plan_key": {
      "type": "string",
      "minLength": 1
    },
    "plan_issue": {
      "type": "integer",
      "minimum": 1
    },
    "filed": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "why"
        ]
      }
    }
  },
  "required": [
    "plan",
    "plan_key",
    "plan_issue",
    "filed"
  ],
  "additionalProperties": false
}
