{
  "name": "@panelator/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The product's web app (spec 112): the shell every later web child builds inside.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "fsd": "steiger ./src --config steiger.config.ts",
    "knip": "knip --directory .. --config web/knip.json --workspace web",
    "test": "vitest run",
    "storybook": "true",
    "build-storybook": "true",
    "e2e": "true"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "^26.6.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "@feature-sliced/steiger-plugin": "catalog:",
    "jsdom": "catalog:",
    "steiger": "catalog:",
    "vitest": "catalog:"
  }
}
